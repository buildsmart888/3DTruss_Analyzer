<Window x:Class="TrussAnalyzer.UI.AppShell.GOStructAnalysisShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:workspace="clr-namespace:TrussAnalyzer.UI.AppShell" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Title="GOStructAnalysis" Height="900" Width="1440" MinHeight="700" MinWidth="1000" Background="#E8EEF1" Closing="WindowClosing">
 <Window.Resources>
  <Style x:Key="CommandButton" TargetType="Button"><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="11,7"/><Setter Property="Foreground" Value="#DCE7EC"/><Setter Property="Background" Value="#1C303B"/><Setter Property="BorderBrush" Value="#405661"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#294553"/><Setter Property="BorderBrush" Value="#E67A38"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger></Style.Triggers></Style>
  <Style x:Key="AccentCommand" TargetType="Button" BasedOn="{StaticResource CommandButton}"><Setter Property="Background" Value="#E56B2C"/><Setter Property="BorderBrush" Value="#F39A65"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="StageButton" TargetType="Button" BasedOn="{StaticResource CommandButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="InspectorLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#5B6E78"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,5,0,2"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#13232D" BorderBrush="#E56B2C" BorderThickness="0,0,0,3"><StackPanel>
   <Grid Margin="22,12,22,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="GO" Foreground="#F08A4B" FontSize="25" FontWeight="Bold"/><TextBlock Text="STRUCT" Foreground="#F5F8F9" FontSize="25" FontWeight="Light" Margin="5,0,0,0"/><TextBlock Text="ANALYSIS" Foreground="#91A6B0" FontSize="11" VerticalAlignment="Bottom" Margin="9,0,0,5"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#44C08A" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock Text="PHYSICAL MODEL WORKSPACE" Foreground="#F1B38A" FontSize="11" FontWeight="SemiBold"/></StackPanel></Grid>
   <Border Background="#0E1A21" Padding="16,7"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource CommandButton}" Content="NEW MODEL" Click="NewRequested"/><Button Style="{StaticResource CommandButton}" Content="OPEN" Click="OpenRequested"/><Button Style="{StaticResource CommandButton}" Content="SAVE" Click="SaveRequested"/><Button Style="{StaticResource CommandButton}" Content="SAVE AS" Click="SaveAsRequested"/><Rectangle Width="1" Height="26" Fill="#3D505A" Margin="9,0"/><Button Style="{StaticResource AccentCommand}" Content="+ NODE" Click="AddNodeRequested"/><Button Style="{StaticResource CommandButton}" Content="FRAME" Click="AddFrameRequested"/><Button Style="{StaticResource CommandButton}" Content="TRUSS" Click="AddTrussRequested"/><Button Style="{StaticResource CommandButton}" Content="GROUP" Click="CreateGroupRequested"/><Button Style="{StaticResource CommandButton}" Content="COLOR" Click="ColorGroupRequested"/><Rectangle Width="1" Height="26" Fill="#3D505A" Margin="9,0"/><Button Style="{StaticResource CommandButton}" Content="ISO" Click="IsoRequested"/><Button Style="{StaticResource CommandButton}" Content="PLAN XY" Click="PlanRequested"/><Button Style="{StaticResource CommandButton}" Content="LABEL SCALE" Click="LabelRequested"/><Button Style="{StaticResource CommandButton}" Content="TRANSPARENCY" Click="TransparencyRequested"/><Rectangle Width="1" Height="26" Fill="#3D505A" Margin="9,0"/><Button Style="{StaticResource CommandButton}" Content="UNDO" Click="UndoRequested" IsEnabled="{Binding CanUndo}"/><Button Style="{StaticResource CommandButton}" Content="REDO" Click="RedoRequested" IsEnabled="{Binding CanRedo}"/><Button Style="{StaticResource AccentCommand}" Content="ANALYZE" Click="AnalyzeRequested"/><Button Style="{StaticResource CommandButton}" Content="RECOVER" Click="RecoverRequested"/></StackPanel></ScrollViewer></Border>
  </StackPanel></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#13232D" Foreground="#DCE7EC" Padding="10,3"><StatusBarItem Content="{Binding CurrentStage}"/><Separator/><StatusBarItem Content="SI · Z-UP"/><Separator/><StatusBarItem Content="{Binding ProjectState}"/><Separator/><StatusBarItem Content="{Binding ProgressText}"/></StatusBar>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightColumn" Width="300"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#1B303B" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="WORKFLOW" Foreground="#91A6B0" FontSize="11" FontWeight="Bold"/><TextBlock Text="Model → evidence" Foreground="#F3F7F8" FontSize="19" Margin="0,4,0,14"/><Button Style="{StaticResource StageButton}" Content="01   PHYSICAL" Click="PhysicalRequested"/><Button Style="{StaticResource StageButton}" Content="02   LOADING" Click="LoadingRequested"/><Button Style="{StaticResource StageButton}" Content="03   ANALYSIS" Click="AnalysisRequested"/><Button Style="{StaticResource StageButton}" Content="04   RESULTS" Click="ResultsRequested"/><Button Style="{StaticResource StageButton}" Content="05   DESIGN" Click="DesignRequested"/><Button Style="{StaticResource StageButton}" Content="06   REPORT" Click="ReportRequested"/><Separator Margin="0,12,0,10" Background="#425866"/><TextBlock Text="MODEL TREE" Foreground="#91A6B0" FontSize="11" FontWeight="Bold"/><TextBox TextChanged="ModelSearchChanged" ToolTip="Search nodes, members, and groups" Margin="0,6,0,5" Padding="7,5" Background="#10212A" Foreground="White" BorderBrush="#4C6672"/><ListBox x:Name="ModelTree" ItemsSource="{Binding VisibleModelItems}" DisplayMemberPath="Label" SelectionChanged="ModelSelectionChanged" Background="#10212A" Foreground="#E3EDF1" BorderBrush="#405864" BorderThickness="1" Height="190"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="RECENT PROJECTS" Foreground="#91A6B0" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/><ListBox ItemsSource="{Binding RecentProjects}" SelectionChanged="RecentProjectSelected" Background="#10212A" Foreground="#DCE7EC" BorderBrush="#405864" BorderThickness="1" MinHeight="100"/></StackPanel></DockPanel></Border>
   <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD7DD" BorderThickness="1,0"><Grid><workspace:PhysicalModelViewport x:Name="PhysicalViewport"/><wfi:WindowsFormsHost x:Name="LegacyHost" Visibility="Collapsed"/><Border x:Name="EmptyModelOverlay" Background="#CCFFFFFF"><Border Width="430" Padding="30" Background="#FFFFFF" BorderBrush="#D3DFE4" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="START A PHYSICAL MODEL" FontSize="21" FontWeight="SemiBold" Foreground="#18313D"/><TextBlock Text="Create a new Model3D project or open an existing .gosa file. Your legacy workspace remains available in the later workflow stages." TextWrapping="Wrap" Margin="0,10,0,18" Foreground="#5B6E78"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource AccentCommand}" Content="CREATE NEW MODEL" Click="NewRequested"/><Button Style="{StaticResource CommandButton}" Content="OPEN PROJECT" Click="OpenRequested" Foreground="#18313D" Background="#F5F8F9" BorderBrush="#AABAC2"/></StackPanel></StackPanel></Border></Border></Grid></Border>
   <Border Grid.Column="2" Background="#F4F7F8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PROJECT" Style="{StaticResource InspectorLabel}"/><TextBlock Text="{Binding DocumentName}" FontSize="21" FontWeight="SemiBold" Foreground="#18313D" Margin="0,2,0,2"/><TextBlock Text="{Binding DocumentPath}" TextWrapping="Wrap" Foreground="#6A7E88" FontSize="11"/><Separator Margin="0,16,0,12"/><TextBlock Text="PROPERTY INSPECTOR" Style="{StaticResource InspectorLabel}"/><TextBlock Text="{Binding SelectedKind}" FontWeight="SemiBold" Foreground="#18313D" Margin="0,3,0,0"/><TextBlock Text="{Binding SelectedId}" TextWrapping="Wrap" Foreground="#6A7E88" FontSize="10" Margin="0,2,0,8"/><Grid IsEnabled="{Binding CanEditSelectedNode}"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Label" Grid.Row="0" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedNodeLabel, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/><TextBlock Text="X" Grid.Row="1" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNodeX, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/><TextBlock Text="Y" Grid.Row="2" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNodeY, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/><TextBlock Text="Z" Grid.Row="3" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNodeZ, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/></Grid><Button Style="{StaticResource CommandButton}" Content="APPLY NODE" Click="ApplyNodeRequested" IsEnabled="{Binding CanEditSelectedNode}" Foreground="#18313D" Background="#FFFFFF" BorderBrush="#9FB0B8" Margin="0,10,0,0"/><Separator Margin="0,18,0,12"/><TextBlock Text="STATUS" Style="{StaticResource InspectorLabel}"/><TextBlock Text="{Binding AnalysisStatus}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#18313D"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,12,0,0"/><Separator Margin="0,20,0,12"/><TextBlock Text="DISPLAY" Style="{StaticResource InspectorLabel}"/><TextBlock Text="Group colour, transparency, and labels are visual-only; they never alter stiffness, loads, or signs." TextWrapping="Wrap" Foreground="#5B6E78" Margin="0,4,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
 </DockPanel>
</Window>
