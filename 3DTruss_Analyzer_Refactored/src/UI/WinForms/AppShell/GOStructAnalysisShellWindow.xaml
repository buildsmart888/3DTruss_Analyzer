<Window x:Class="TrussAnalyzer.UI.AppShell.GOStructAnalysisShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="GOStructAnalysis" Height="900" Width="1440" MinHeight="700" MinWidth="1000" Background="#F1F3F4" Closing="WindowClosing">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#5B6670"/><Setter Property="Foreground" Value="#E7EDF0"/></Style>
        <Style x:Key="StageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17242E" BorderBrush="#E66928" BorderThickness="0,0,0,3">
            <StackPanel>
                <Grid Margin="18,10,18,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="GO" Foreground="#F18A4B" FontSize="23" FontWeight="Bold"/><TextBlock Text="STRUCT" Foreground="#E7EDF0" FontSize="23" FontWeight="Light" Margin="4,0,0,0"/><TextBlock Text="ANALYSIS" Foreground="#8DA0AC" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,4"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="LINEAR FRAME / TRUSS · PRELIMINARY" Foreground="#F1B38A" VerticalAlignment="Center" FontSize="11"/>
                </Grid>
                <ToolBarTray><ToolBar Background="#17242E" BorderBrush="#17242E">
                    <Button Content="NEW" Click="NewRequested"/><Button Content="OPEN" Click="OpenRequested"/><Button Content="SAVE" Click="SaveRequested"/><Button Content="SAVE AS" Click="SaveAsRequested"/><Separator/><Button Content="NODE" Click="AddNodeRequested"/><Button Content="FRAME" Click="AddFrameRequested"/><Button Content="TRUSS" Click="AddTrussRequested"/><Button Content="ISO" Click="IsoRequested"/><Button Content="XY" Click="PlanRequested"/><Button Content="LABEL+" Click="LabelRequested"/><Button Content="FADE" Click="TransparencyRequested"/><Separator/><Button Content="UNDO" Click="UndoRequested" IsEnabled="{Binding CanUndo}"/><Button Content="REDO" Click="RedoRequested" IsEnabled="{Binding CanRedo}"/><Separator/><Button Content="ANALYZE" Click="AnalyzeRequested" Background="#E66928" BorderBrush="#E66928"/><Button Content="CANCEL" Click="CancelRequested"/><Separator/><Button Content="RESET LAYOUT" Click="ResetLayoutRequested"/><Button Content="TH/EN" Click="LanguageRequested"/><Button Content="RECOVER" Click="RecoverRequested"/>
                </ToolBar></ToolBarTray>
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#17242E" Foreground="#DCE4E8"><StatusBarItem Content="{Binding CurrentStage}"/><Separator/><StatusBarItem Content="SI · Z-UP · NATIVE DENSE"/><Separator/><StatusBarItem Content="{Binding ProjectState}"/><Separator/><StatusBarItem Content="{Binding ProgressText}"/></StatusBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightColumn" Width="280"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#22333F" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="WORKFLOW" Foreground="#8DA0AC" FontSize="11" FontWeight="Bold"/><TextBlock Text="Model to evidence" Foreground="#E7EDF0" FontSize="17" Margin="0,4,0,12"/><Button Style="{StaticResource StageButton}" Content="01  PHYSICAL" Click="PhysicalRequested"/><Button Style="{StaticResource StageButton}" Content="02  LOADING" Click="LoadingRequested"/><Button Style="{StaticResource StageButton}" Content="03  ANALYSIS" Click="AnalysisRequested"/><Button Style="{StaticResource StageButton}" Content="04  RESULTS" Click="ResultsRequested"/><Button Style="{StaticResource StageButton}" Content="05  DESIGN" Click="DesignRequested"/><Button Style="{StaticResource StageButton}" Content="06  REPORT" Click="ReportRequested"/><TextBlock Text="MODEL TREE" Foreground="#8DA0AC" FontSize="11" FontWeight="Bold" Margin="0,14,0,4"/><TextBox TextChanged="ModelSearchChanged" ToolTip="Search nodes and members"/><ListBox ItemsSource="{Binding VisibleModelItems}" DisplayMemberPath="Label" SelectionChanged="ModelSelectionChanged" Background="#17242E" Foreground="#DCE4E8" BorderThickness="0" Height="180"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="RECENT PROJECTS" Foreground="#8DA0AC" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/><ListBox ItemsSource="{Binding RecentProjects}" SelectionChanged="RecentProjectSelected" Background="#17242E" Foreground="#DCE4E8" BorderThickness="0" MinHeight="90"/></StackPanel></DockPanel></Border>
            <Border Grid.Column="1" Background="#FFFFFF" Padding="1"><wfi:WindowsFormsHost x:Name="LegacyHost" /></Border>
            <Border Grid.Column="2" Background="#E8ECEE" Padding="16"><StackPanel><TextBlock Text="PROJECT CONTROL" Foreground="#55636B" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding DocumentName}" FontSize="20" FontWeight="SemiBold" Foreground="#17242E" Margin="0,5,0,2"/><TextBlock Text="{Binding DocumentPath}" TextWrapping="Wrap" Foreground="#66757E" FontSize="11"/><Separator Margin="0,15,0,10"/><TextBlock Text="ANALYSIS STATUS" Foreground="#55636B" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding AnalysisStatus}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#17242E"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,12,0,0"/><Separator Margin="0,20,0,10"/><TextBlock Text="STAGED MIGRATION" Foreground="#55636B" FontSize="11" FontWeight="Bold"/><TextBlock Text="The compatible WinForms workspace is hosted while document, analysis, and lifecycle services move behind stable application boundaries." TextWrapping="Wrap" Foreground="#55636B" Margin="0,5,0,0"/></StackPanel></Border>
        </Grid>
    </DockPanel>
</Window>
